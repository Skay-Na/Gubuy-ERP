APP_PORT=8080
TZ=Asia/Shanghai

DB_USER=root
DB_PASS=rootpassword
DB_HOST=db
DB_PORT=3306
DB_NAME=erp_db

# Generate a private random value of at least 32 bytes before starting the service.
JWT_SECRET=
BACKUP_UPLOAD_MAX_MB=200

# 图片识别：使用支持图片输入和 JSON 输出的模型
AI_API_KEY=
AI_MODEL=
AI_API_URL=https://api.openai.com/v1/chat/completions
# 可选：设置页保存的服务商 Key 使用此密钥加密；未设置时使用安全的 JWT_SECRET
AI_CONFIG_SECRET=

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=erp_db
MYSQL_HOST_PORT=3307
AGENT_MONITOR_ENABLED=0
# Enable the unified durable Agent Runtime worker (supersedes the legacy monitor ticker).
AGENT_RUNTIME_ENABLED=0
ERP_SEED_DEMO_DATA=0
