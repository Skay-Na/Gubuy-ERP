APP_PORT=8080
TZ=Asia/Shanghai

DB_USER=root
DB_PASS=rootpassword
DB_HOST=db
DB_PORT=3306
DB_NAME=erp_db

# Generate a private random value of at least 32 bytes before starting the service.
JWT_SECRET=
BACKUP_UPLOAD_MAX_MB=200

# CORS 白名单（逗号分隔的 Origin）；留空使用内置默认值（本地开发 + 生产地址）
CORS_ALLOW_ORIGINS=http://localhost:5173,http://192.168.5.22:8080

# 图片识别：使用支持图片输入和 JSON 输出的模型
AI_API_KEY=
AI_MODEL=
AI_API_URL=https://api.openai.com/v1/chat/completions
# 可选：设置页保存的服务商 Key 使用此密钥加密；未设置时使用安全的 JWT_SECRET
AI_CONFIG_SECRET=

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=erp_db
MYSQL_HOST_PORT=3307
# Local development: Go/Air on the host, Vite proxies requests to it.
DEV_API_PORT=8081
DEV_VITE_PORT=5173
DEV_OPEN_BROWSER=1
# Enable the durable Agent Runtime worker. Inventory alert scans are retired.
AGENT_RUNTIME_ENABLED=0
# Enable LLM-driven planning through the existing configured provider. Requires a durable task worker.
AGENT_LLM_PLANNER_ENABLED=0
# Legacy setting retained for existing .env files; starts task polling only. No inventory schedules are run.
AGENT_PERSISTENT_SCHEDULER_ENABLED=0
# Legacy inventory rewrite; keep disabled unless separately reviewed and approved.
ERP_MIGRATE_UNIFIED_CLOUD_INVENTORY=0
ERP_SEED_DEMO_DATA=0
