# Agent 服务监听端口
AGENT_SERVICE_PORT=8082

# MySQL（与 ERP 后端共用同一数据库）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=rootpassword
DB_NAME=erp_db

# 与 Go 后端一致的 JWT 密钥（>=32 字节）
JWT_SECRET=erp_wonchon_default_secret_key_2026_please_change

# AI 配置加密密钥（与 Go 后端 AI_CONFIG_SECRET 一致；留空则回退 JWT_SECRET）
AI_CONFIG_SECRET=

# Go 后端地址（工具调用与记账写入走这里）
ERP_API_URL=http://127.0.0.1:8081

# 环境变量兜底模型配置（系统设置里未启用任何服务商时使用，OpenAI 兼容接口）
AI_API_KEY=
AI_MODEL=
# 完整 chat/completions 地址或 API 根地址均可
AI_API_URL=
